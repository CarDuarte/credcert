# Copy this file to .env and fill in real values.
# NEVER commit .env -- it's already in .gitignore.

# --- Core ---
# development | production
ENVIRONMENT=development
DEBUG=false

# Generate with: openssl rand -hex 32
# Required (>=32 chars) in production; auto-generated (and thrown away on
# restart) in development if left blank.
SECRET_KEY=

# SQLite is fine for local dev/demo only. In production, point this at a
# real database (e.g. postgresql+psycopg://user:pass@host:5432/credtrace).
DATABASE_URL=sqlite:///./credtrace.db

# --- Deploying to Vercel + Supabase ---
# Set DATABASE_URL to Supabase's TRANSACTION-MODE POOLER connection string
# (port 6543) -- NOT the direct connection (port 5432). Serverless
# functions don't maintain long-lived connections; going direct exhausts
# Postgres's connection limit under concurrent load. Supabase gives you
# this string on the project's Connect page. A bare postgresql:// or
# postgres:// URL is fine -- the app normalizes it to use the psycopg v3
# driver automatically.
# DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Migrations need a connection that supports DDL and session-level
# features -- either Supabase's DIRECT connection or the pooler's SESSION
# MODE (same pooler host as above, port 5432 instead of 6543). Set this
# when running `alembic upgrade head` locally or in CI; the running app
# never reads this variable, only alembic does.
# MIGRATION_DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# --- Sessions ---
SESSION_MAX_AGE_SECONDS=28800      # 8 hours
SESSION_IDLE_TIMEOUT_SECONDS=1800  # 30 minutes

# --- Network / TLS ---
# Defaults to true in production, false otherwise. Uncomment to override.
# FORCE_HTTPS=true
# Include your Vercel domain(s) here in production, e.g.:
# TRUSTED_HOSTS=your-app.vercel.app,your-custom-domain.com
TRUSTED_HOSTS=localhost,127.0.0.1

# --- Brute-force protection ---
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT=10/minute

# --- Bootstrapping the first admin user (scripts/seed.py only, not the app itself) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
